{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "jsx": "react-native",
    "moduleResolution": "node",
    "allowJs": true,
    "strict": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
